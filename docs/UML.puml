@startuml
skinparam packageStyle rectangle

package onion.lifeproducts.rms.presentation {
  class Main {
    + main(String[] args): void
  }

  class ConsoleUI {
    - ConsoleUIEntry[] mainOptions
    - HashMap<String, Runnable> mainChoicesMappings
    - ConsoleUIANSIOptions ansiOptions
    - String ANSI_CURRENT
    - boolean activeMenuLoop
    + ConsoleUI()
    + ConsoleUI(ConsoleUIEntry[] mainOptions, ConsoleUIANSIOptions menuANSIOptions)
    + runMenu(): void
  }

  class ConsoleUIEntry {
    - String key
    - String description
    - String command
    - Runnable callback
    {static} - String[] allowedCommands
    + ConsoleUIEntry(String key, String description, String command)
    + ConsoleUIEntry(String key, String description, Runnable callback)
    + key(): String
    + description(): String
    + command(): String
    + callback(): Runnable
  }

  class ConsoleUIEntryChecker {
    {static} + checkConsoleUIEntryOptions(ConsoleUIEntry[] consoleUIEntries): void
  }

  class ConsoleUIANSIOptions {
    + String USER_INPUT
    + String MENU_OPTION_KEY
    + String MENU_OPTION_HIGHLIGHT
    + ConsoleUIANSIOptions()
    + ConsoleUIANSIOptions(String userInput)
    + ConsoleUIANSIOptions(String userInput, String menuOptionKey, String menuOptionHighlight)
  }

  class ANSI {
    {static} + formatString(String str, String format): String
  }

  class Util {
    {static} - Scanner scanner
    {static} + ConsoleUIANSIOptions defaultConsoleUIANSIOptions
    + Util(ConsoleUIANSIOptions defaultConsoleUIANSIOptions)
    {static} + clearScreen(): void
    {static} + changeConsoleUIANSIOptions(ConsoleUIANSIOptions defaultConsoleUIANSIOptions): void
    {static} + getLine(): String
    {static} + getLine(String prompt): String
    {static} + getLine(String prompt, String ansiUserInput): String
    {static} + getLineAnswer(): String
    {static} + getLineAnswer(String prompt): String
    {static} + getLineAnswer(String prompt, String ansiUserInput): String
  }

  class Data {
    {static} + ConsoleUIEntry[] mainMenuChoices
  }
}

package onion.lifeproducts.rms.application {
  class ApplicationService {
    - StoragePool storagePool
    + ApplicationService()
    + addProduct(String name, Map<Integer, Float> materialRatios, LocalDateTime lifespan): int
    + addMaterial(String name, float recycleRate, float emissionFactor, int recyclingCategory, String recyclingGuidance): int
    + addRecyclingGuidance(String type): boolean
    + getAllProducts(): List<Product>
    + getAllProductIds(): List<Integer>
    + getAllMaterials(): List<Material>
    + getAllMaterialIds(): List<Integer>
    + getAllRecyclingCategories(): List<RecyclingCategory>
    + getAllProductDescriptions(): List<String>
    + getAllMaterialDescriptions(): List<String>
    + getAllRecyclingCategoryDescriptions(): List<String>
    + getProductDescriptionById(int id): List<String>
    + getMaterialDescriptionById(int id): List<String>
    + getRecyclingCategoryDescriptionById(int id): List<String>
    + recycleProductById(int id, int impactCalculationStrategyId): List<String>
    - getRecyclingCategoryFromIndex(int index): RecyclingCategory
    - createImpactCalculationStrategy(int strategyId): ImpactCalculationStrategyInterface
    - resolveMaterials(Map<Integer, Float> materialRatios): Map<Material, Float>
  }

  class StoragePool {
    - List<Product> productsPool
    - List<Material> materialsPool
    - List<RecyclingGuidance> recyclingGuidancePool
    + StoragePool()
    + addProduct(Product product): void
    + addMaterial(Material material): void
    + addRecyclingGuidance(RecyclingGuidance recyclingGuidance): void
    + getAllProducts(): List<Product>
    + getAllMaterials(): List<Material>
    + getAllRecyclingGuidance(): List<RecyclingGuidance>
    + getProductById(int id): Product
    + getMaterialById(int id): Material
    + getRecyclingGuidanceById(int id): RecyclingGuidance
    + deleteProductById(int id): Product
    + deleteMaterialById(int id): Material
    + deleteRecyclingGuidanceById(int id): RecyclingGuidance
  }

  class RecyclingService {
    - ImpactCalculationStrategyInterface impactCalculationStrategy
    + RecyclingService(ImpactCalculationStrategyInterface impactCalculationStrategy)
    + recycle(Product product): float
    + recycleAll(Product[] products): float
    + recycle(Material material): float
    + recycleAll(Material[] materials): float
    + generateReport(Product product): ImpactReport
    + generateReportForAll(Product[] products): ImpactReport
    + generateReportForEach(Product[] products): ImpactReport[]
  }
}

package onion.lifeproducts.rms.domain {
  class Product {
    {static} - int nextId
    - int id
    - String name
    - Map<Material, Float> materials
    - LocalDateTime manufactureDate
    - LocalDateTime endDate
    + Product(String name, Map<Material, Float> materials, LocalDateTime manufactureDate, LocalDateTime endDate)
    + getId(): int
    + getName(): String
    + getManufactureDate(): LocalDateTime
    + getEndDate(): LocalDateTime
    + getMaterials(): Map<Material, Float>
    + setName(String name): boolean
    + toString(): String
  }

  class Material {
    {static} - int nextId
    - int id
    - String name
    - float recycleRate
    - float emissionFactor
    - RecyclingCategory recyclingCategory
    - RecyclingGuidance recyclingGuidance
    + Material(String name, float recycleRate, float emissionFactor, RecyclingCategory recyclingCategory, RecyclingGuidance recyclingGuidance)
    + getId(): int
    + getName(): String
    + getRecycleRate(): float
    + getEmissionFactor(): float
    + getRecyclingCategory(): RecyclingCategory
    + getRecyclingGuidance(): RecyclingGuidance
    + setName(String name): boolean
    + toString(): String
  }

  class RecyclingGuidance {
    {static} - int nextId
    - int id
    - String guide
    + RecyclingGuidance(String guide)
    + getId(): int
    + getGuide(): String
    + toString(): String
  }

  enum RecyclingCategory {
    RECYCLABLE
    PARTIALLY_RECYCLABLE
    NON_RECYCLABLE
  }

  class ImpactReport {
    - LocalDateTime generatedAt
    - float impactValue
    - int productsAmountUsed
    - int materialsAmountUsed
    - int uniqueMaterialAmountUsed
    + ImpactReport(LocalDateTime generatedAt, float impactValue, int productsAmountUsed, int materialsAmountUsed, int uniqueMaterialAmountUsed)
    + getGeneratedAtDate(): LocalDateTime
    + getImpactValue(): float
    + getProductsAmountUsed(): int
    + getMaterialsAmountUsed(): int
    + getUniqueMaterialAmountUsed(): int
  }

  interface ImpactCalculationStrategyInterface {
    + calculateImpact(Product product): float
    + calculateImpact(Product[] products): float
    + calculateImpact(List<Product> products): float
  }

  class SimpleImpactCalculationStrategy
  class WeightPlusLifespanImpactCalculationStrategy
}

Main --> ConsoleUI
Main --> Data
Main --> Util

ConsoleUI o-- "0..*" ConsoleUIEntry
ConsoleUI --> ConsoleUIANSIOptions
ConsoleUI --> ConsoleUIEntryChecker
ConsoleUI --> Util
ConsoleUI --> ANSI

Data --> ConsoleUIEntry
Util --> ConsoleUIANSIOptions
ConsoleUIANSIOptions --> ANSI

ApplicationService *-- StoragePool
ApplicationService --> RecyclingService
ApplicationService --> ImpactCalculationStrategyInterface
ApplicationService --> Product
ApplicationService --> Material
ApplicationService --> RecyclingGuidance
ApplicationService --> RecyclingCategory

StoragePool o-- "0..*" Product
StoragePool o-- "0..*" Material
StoragePool o-- "0..*" RecyclingGuidance

RecyclingService o-- ImpactCalculationStrategyInterface
RecyclingService --> Product
RecyclingService --> Material
RecyclingService --> ImpactReport

Material *-- RecyclingGuidance
Material --> RecyclingCategory

Product --> "0..*" Material : stores materials/ratios

ImpactCalculationStrategyInterface <|.. SimpleImpactCalculationStrategy
ImpactCalculationStrategyInterface <|.. WeightPlusLifespanImpactCalculationStrategy
ImpactCalculationStrategyInterface --> Product

SimpleImpactCalculationStrategy --> Material : uses emissionFactor
WeightPlusLifespanImpactCalculationStrategy --> Material : uses emissionFactor

@enduml