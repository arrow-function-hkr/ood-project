@startuml

package onion.lifeproducts.rms {

    package presentation {

        class ConsoleUI {
            + ConsoleUI()
            + runMenu(): void
        }

        class Data
        class Util
        class ConsoleUIEntry
        class ConsoleUIANSIOptions
    }

    package application {

        class ApplicationService {
            - StoragePool storagePool

            + addProduct(String name, List<Material> materials, LocalDateTime manufactureDate, LocalDateTime endDate): Integer
            + addMaterial(String name, float recycleRate, float burnAtmosphereImpact, float decayAtmosphereImpact, float decayGroundImpact, float burnEnvironmentImpact, float decayEnvironmentImpact, LocalDateTime burnTime, LocalDateTime decayTime): Integer

            + addProductCategory(String type): boolean
            + addRecyclingCategory(String type): boolean
            + addRecyclingGuidance(String type): boolean

            + getAllProducts(): List<Product>
            + getAllProductIds(): List<Integer>
            + getAllMaterials(): List<Material>
            + getAllMaterialIds(): List<Integer>
            + getAllProductCategories(): List<ProductCategory>
            + getAllRecyclingCategories(): List<RecyclingCategory>
        }

        class StoragePool {
            - List<Product> productsPool
            - List<Material> materialsPool
            - List<ProductCategory> productCategoryPool
            - List<RecyclingCategory> recyclingCategoryPool
            - List<RecyclingGuidance> recyclingGuidancePool

            + addProduct(Product product): void
            + addMaterial(Material material): void
            + addProductCategory(ProductCategory productCategory): void
            + addRecyclingCategory(RecyclingCategory recyclingCategory): void
            + addRecyclingGuidance(RecyclingGuidance recyclingGuidance): void

            + getAllProducts(): List<Product>
            + getAllMaterials(): List<Material>
            + getAllProductCategories(): List<ProductCategory>
            + getAllRecyclingCategories(): List<RecyclingCategory>
            + getAllRecyclingGuidances(): List<RecyclingGuidance>
        }

        class RecyclingService
    }

    package domain {

        class Product {
            - int id
            - String name
            - List<Material> materials
            - LocalDateTime manufactureDate
            - LocalDateTime endDate

            + Product(String name, List<Material> materials, LocalDateTime manufactureDate, LocalDateTime endDate)
            + getId(): int
            + getName(): String
            + getMaterials(): List<Material>
            + getManufactureDate(): LocalDateTime
            + getEndDate(): LocalDateTime
        }

        class Material {
            - int id
            - String name
            - float recycleRate
            - float burnAtmosphereImpact
            - float decayAtmosphereImpact
            - float decayGroundImpact
            - float burnEnvironmentImpact
            - float decayEnvironmentImpact
            - LocalDateTime burnTime
            - LocalDateTime decayTime

            + Material(String name, float recycleRate, float burnAtmosphereImpact, float decayAtmosphereImpact, float decayGroundImpact, float burnEnvironmentImpact, float decayEnvironmentImpact, LocalDateTime burnTime, LocalDateTime decayTime)
            + getId(): int
            + getName(): String
            + getRecycleRate(): float
            + getBurnAtmosphereImpact(): float
            + getDecayAtmosphereImpact(): float
            + getDecayGroundImpact(): float
            + getBurnEnvironmentImpact(): float
            + getDecayEnvironmentImpact(): float
            + getBurnTime(): LocalDateTime
            + getDecayTime(): LocalDateTime
        }

        class ProductCategory {
            - String type
            + ProductCategory(String type)
            + getType(): String
        }

        class RecyclingCategory {
            - String type
            + RecyclingCategory(String type)
            + getType(): String
        }

        class RecyclingGuidance {
            - int id
            - String type
            + RecyclingGuidance(String type)
            + getId(): int
            + getType(): String
        }

        class ImpactReport

        interface ImpactCalculationStrategyInterface {
            + calculateImpact(Product product): float
            + calculateImpact(Product[] products): float
            + calculateImpact(List<Product> products): float
        }

        class SimpleImpactCalculationStrategy
        class WeightPlusLifespanImpactCalculationStrategy
    }
}

Product "1" *-- "0..*" Material : contains

StoragePool "1" o-- "0..*" Product
StoragePool "1" o-- "0..*" Material
StoragePool "1" o-- "0..*" ProductCategory
StoragePool "1" o-- "0..*" RecyclingCategory
StoragePool "1" o-- "0..*" RecyclingGuidance

ApplicationService "1" *-- "1" StoragePool : uses
ConsoleUI --> ApplicationService : calls

ImpactCalculationStrategyInterface <|.. SimpleImpactCalculationStrategy
ImpactCalculationStrategyInterface <|.. WeightPlusLifespanImpactCalculationStrategy

SimpleImpactCalculationStrategy --> Product : calculates
WeightPlusLifespanImpactCalculationStrategy --> Product : calculates

Product --> Material : reads materials

@enduml